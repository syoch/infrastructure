# Portal API base the Vite dev server proxies same-origin requests to.
# Default (unset) is http://localhost:8000 (a local portal).
# To develop against a real deployment, copy this file to .env and set:
#   PORTAL_API_BASE=https://portal.syoch.org
# Or export it in the shell:
#   PORTAL_API_BASE=https://portal.syoch.org npm run dev
PORTAL_API_BASE=http://localhost:8000

# Set to 1 to accept self-signed TLS certificates on the API target.
PORTAL_API_INSECURE=0

# Optional: Cloudflare Access service token, forwarded to the API target as
# CF-Access-Client-Id / CF-Access-Client-Secret. Needed when PORTAL_API_BASE
# points at a Cloudflare Access protected deployment (the browser has no
# session cookie for it from the dev origin).
PORTAL_API_ACCESS_CLIENT_ID=
PORTAL_API_ACCESS_CLIENT_SECRET=
